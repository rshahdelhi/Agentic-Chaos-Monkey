# Copy this file to .env and replace the placeholder.
# Never commit the real key.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# The ADK Gemini model can be overridden without changing source code.
GEMINI_MODEL=gemini-flash-latest

# OpenTelemetry: use "console" locally or "otlp" with an OTLP collector.
OTEL_SERVICE_NAME=agentic-chaos-monkey
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
